{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build with Make",
      "command": "make all",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:/msys64/usr/bin/bash.exe",
          "args": ["--login", "-c"]
        },
        "env": {
          "CHERE_INVOKING": "1",
          "MSYSTEM": "MINGW64",
          "MSYS2_PATH_TYPE": "inherit"
        }
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}